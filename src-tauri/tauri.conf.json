{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Misty Setup",
  "version": "0.1.0",
  "identifier": "app.misty.setup",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1 --port 1420",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Misty",
        "width": 560,
        "height": 720,
        "minWidth": 500,
        "minHeight": 640,
        "maxWidth": 640,
        "maxHeight": 780,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
